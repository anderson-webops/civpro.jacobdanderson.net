# Example direct static-host configuration for the validated dist/client artifact.
# TLS, DNS, and listener ownership remain deployment-environment concerns.

server {
    listen 127.0.0.1:8080;
    server_name civpro.jacobdanderson.net;

    root /srv/civpro.jacobdanderson.net/current/dist/client;
    index index.html;

    add_header Content-Security-Policy "default-src 'self'; base-uri 'none'; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self'; style-src 'self'; upgrade-insecure-requests" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;
    add_header Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Cache-Control "public, max-age=0, must-revalidate" always;

    location ~ (^|/)(?:\.env|\.git|\.github|\.ai-work|data|deploy|node_modules|ops|scripts|tests)(?:/|$) {
        return 404;
    }

    location = /rule-tests.js {
        return 404;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
